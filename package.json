{
  "name": "ersinbinal-site-tools",
  "version": "1.0.0",
  "description": "Convivium GitHub Pages site: terminal UI, articles, games, PWA assets, Supabase helpers, and Oracle Worker tooling.",
  "scripts": {
    "check": "npm run check:syntax && npm run check:sync && npm run test:unit && npm run test:worker && npm run check:site",
    "check:site": "node scripts/validate-site-integrity.js",
    "check:syntax": "node scripts/check-syntax.js",
    "convert-images": "node scripts/convert-images.js",
    "sync:cache": "node scripts/sync-cache-versions.js",
    "sync:cache:bump": "node scripts/sync-cache-versions.js --bump",
    "set:oracle-endpoint": "node scripts/set-oracle-endpoint.js",
    "test": "npm run test:unit && npm run test:worker && npm run test:smoke && npm run test:e2e",
    "test:smoke": "node tests/smoke/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:worker": "vitest run --config vitest.config.mjs",
    "test:e2e": "playwright test",
    "build:bugy-v3": "em++ src/native/bugy-v3/bugy_v3.cpp -O3 --no-entry -s STANDALONE_WASM=1 -s EXPORTED_FUNCTIONS='[\"_bugy_init\",\"_bugy_update\",\"_bugy_trigger\",\"_bugy_next\",\"_bugy_set_skin\",\"_bugy_framebuffer\",\"_bugy_width\",\"_bugy_height\",\"_bugy_x\",\"_bugy_y\",\"_bugy_state\",\"_bugy_skin\"]' -o assets/wasm/bugy-v3.wasm",
    "build:bugy-v3-atlas": "node scripts/build-bugy-v3-atlas.js",
    "build:moto": "node scripts/build-moto-frames.js",
    "deploy:oracle": "npx wrangler deploy -c workers/oracle/wrangler.toml",
    "check:sync": "node scripts/sync-cache-versions.js --check",
    "publish:slice": "node scripts/publish-slice.js",
    "test:accept": "node tests/acceptance/kabul.mjs",
    "build:tortu": "node scripts/build-tortu.js",
    "docs:terminal": "node scripts/build-terminal-guide.js",
    "build:arsiv": "node scripts/build-arsiv-index.js",
    "build:migration": "node scripts/build-migration-bundle.js",
    "build:guide-shots": "node scripts/build-guide-shots.js",
    "build:okkam": "node scripts/build-okkam.js",
    "build:filiz": "node scripts/build-filiz.js",
    "filiz:zar": "node scripts/filiz-zar.js"
  },
  "dependencies": {
    "fast-glob": "^3.2.12",
    "sharp": "^0.32.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@playwright/test": "^1.49.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
